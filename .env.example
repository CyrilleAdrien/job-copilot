# Copier en .env puis adapter. Ne jamais commiter .env.

POSTGRES_USER=jobcopilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobcopilot

# Ports locaux (exposés sur 127.0.0.1 uniquement)
WEB_PORT=3000
GATEWAY_PORT=8000

# Modèle LLM téléchargé par `make models`. Un autre modèle installé se choisit dans Réglages.
OLLAMA_MODEL=qwen2.5:7b
# Ollama tourne dans Docker par défaut, grâce au profil ci-dessous. Sur Mac, Docker n'a
# pas accès au GPU : installe Ollama nativement (https://ollama.com/download), supprime
# la ligne COMPOSE_PROFILES et décommente OLLAMA_URL.
COMPOSE_PROFILES=ollama
# OLLAMA_URL=http://host.docker.internal:11434
# ollama, ou demo pour générer CV et lettre sans LLM (contenu du profil repris tel quel)
LLM_PROVIDER=ollama
# Délai maximal d'une réponse du modèle, en secondes (sur processeur, un 7B est lent)
LLM_TIMEOUT=600

# Sources d'offres (gratuites). Se saisissent aussi dans Réglages, où elles sont chiffrées et
# priment sur ces lignes. Laisser vide pour désactiver une source.
# France Travail : https://francetravail.io, application avec l'API « Offres d'emploi v2 »
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# Adzuna : https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Offres fictives pour essayer l'outil sans clé
JOBS_DEMO=false

# Clé de chiffrement des mots de passe (mail, CalDAV). `make secret` la génère.
SECRET_KEY=
# Boîte de démonstration (réponses fictives à tes candidatures), sans compte IMAP
MAIL_DEMO=false
# Lecture automatique des boîtes, en minutes
MAIL_SYNC_MINUTES=15
# Calendrier CalDAV de démonstration (en mémoire), sans compte iCloud
CALENDAR_DEMO=false
